{
  "name": "quox-plugin-sdk-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Tools for building third-party Quox plugins",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test:vitest && npm run test:node",
    "test:vitest": "vitest run",
    "test:node": "node --test packages/quox-glyph/test/glyph.test.mjs",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "jsdom": "^29.0.1",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
